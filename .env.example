# Copy to .env.local for local dev. On Vercel, set these in the project settings.

# Neon Postgres (injected automatically by the Vercel Neon integration)
DATABASE_URL=
DATABASE_URL_UNPOOLED=        # optional: direct (non-pooled) URL, used for migrations

# AI import (slice 2). Provider and model are never hard-coded.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite,gemini-3.8-flash   # optional, comma-separated, tried in order when the model before is overloaded or out of quota
GEMINI_API_KEY=
ANTHROPIC_API_KEY=            # optional, only if LLM_PROVIDER=anthropic

# 32 random bytes, base64: openssl rand -base64 32
# Encrypts saved API credentials (AES-256-GCM) and derives the session-cookie key.
CREDENTIALS_ENCRYPTION_KEY=

# Passcode for the demo workspace (min 8 chars)
APP_PASSCODE=

# Approval emails (optional). Without a verified domain, Resend only delivers to your own account email.
RESEND_API_KEY=
NOTIFY_FROM=BYOMCP <onboarding@resend.dev>

# Connect with Zendesk (optional). Register an OAuth client in your Zendesk Admin Center with redirect URL <your site>/api/oauth/zendesk/callback.
ZENDESK_OAUTH_CLIENT_ID=
ZENDESK_OAUTH_CLIENT_SECRET=
ZENDESK_OAUTH_SUBDOMAIN=
